{
  "opencollection": "1.0.0",
  "info": {
    "name": "Best Buy Products Stores API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "apiKey",
      "value": "{{apiKey}}",
      "placement": "query"
    }
  },
  "items": [
    {
      "info": {
        "name": "Stores",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Best Buy List Stores",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bestbuy.com/v1/stores",
            "params": [
              {
                "name": "apiKey",
                "value": "YourAPIKey",
                "type": "query",
                "description": "Your Best Buy developer API key."
              },
              {
                "name": "format",
                "value": "json",
                "type": "query",
                "description": "Response format - json or xml."
              },
              {
                "name": "show",
                "value": "storeId,name,city,state,distance",
                "type": "query",
                "description": "Comma-separated list of attributes to return."
              },
              {
                "name": "area",
                "value": "area(94103,25)",
                "type": "query",
                "description": "Search for stores near a location. Format: area(postalCode,radius) or area(latitude,longitude,radius). Default radius is 10 miles."
              },
              {
                "name": "pageSize",
                "value": "10",
                "type": "query",
                "description": "Number of results per page. Maximum 100."
              },
              {
                "name": "page",
                "value": "1",
                "type": "query",
                "description": "Page number for pagination."
              },
              {
                "name": "sort",
                "value": "distance.asc",
                "type": "query",
                "description": "Sort attribute and direction, e.g. distance.asc."
              }
            ]
          },
          "docs": "Query all Best Buy store locations with filtering, area-based proximity searches, and sorting. Returns store details including address, hours, services, and operational information."
        },
        {
          "info": {
            "name": "Best Buy Get Store by ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bestbuy.com/v1/stores/:storeId",
            "params": [
              {
                "name": "storeId",
                "value": "281",
                "type": "path",
                "description": "The unique Best Buy store identifier."
              },
              {
                "name": "apiKey",
                "value": "YourAPIKey",
                "type": "query",
                "description": "Your Best Buy developer API key."
              },
              {
                "name": "format",
                "value": "json",
                "type": "query",
                "description": "Response format - json or xml."
              }
            ]
          },
          "docs": "Retrieve detailed information for a specific Best Buy store including address, hours, services, and operational attributes."
        }
      ]
    }
  ],
  "bundled": true
}